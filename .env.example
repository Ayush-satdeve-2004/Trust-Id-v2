# ==============================================================================
# RAZORPAY TRUST-ID ENGINE v2.0 - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and populate with your production / sandbox keys.

# ------------------------------------------------------------------------------
# 1. SERVER & CLOUD DEPLOYMENT
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. RAZORPAY PAYMENT GATEWAY CREDENTIALS (REDUNDANT IN SIMULATION MODE)
# ------------------------------------------------------------------------------
# Used for live Razorpay Checkout webhook validation & automated refunds.
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ------------------------------------------------------------------------------
# 3. CRYPTOGRAPHY & AES-256 VAULT SECURITY
# ------------------------------------------------------------------------------
# Secret key for sealing ISO/IEC Bank Dispute Dossier payloads in 120-day vault.
VAULT_AES256_SECRET_KEY=e83a7f901c24b3d87e502189a456c7d1e2f3a4b5c6d7e8f90a1b2c3d4e5f6a7b
# RSA-4096 Digital Signature Key pair path for doorstep handover signatures.
RSA4096_PRIVATE_KEY_PATH=./keys/rsa4096_private.pem
RSA4096_PUBLIC_KEY_PATH=./keys/rsa4096_public.pem

# ------------------------------------------------------------------------------
# 4. LOGISTICS & GEOFENCE TELEMETRY
# ------------------------------------------------------------------------------
# Geofence proximity threshold in meters for triggering OTP & Email 2 link.
GEOFENCE_RADIUS_METERS=800
# Logistics partner webhook API keys (BlueDart, Delhivery, Shadowfax, Shiprocket)
BLUEDART_API_KEY=your_bluedart_api_key
DELHIVERY_API_KEY=your_delhivery_api_key

# ------------------------------------------------------------------------------
# 5. EMAIL DISPATCHER & NOTIFICATIONS
# ------------------------------------------------------------------------------
# SMTP Server credentials for delivering Email 1 (OTP) & Email 2 (Webpage Link)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@trust-id-engine.com
SMTP_PASS=your_smtp_app_password
EMAIL_FROM_NAME="Razorpay Trust-ID Delivery Handover"
